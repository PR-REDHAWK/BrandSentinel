# ==============================================================================
# BrandSentinel — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
frontend/.env
backend/.env
*.pem
*.key
*.cert
credentials.json
token.json

# ------------------------------------------------------------------------------
# 2. Database Files & Data Heavy Artifacts
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
brandsentinel.db
test_brandsentinel.db
pgdata/
data/

# ------------------------------------------------------------------------------
# 3. User Uploads & Ingested Document Storage
# ------------------------------------------------------------------------------
uploads/
backend/uploads/
*/uploads/
*.pdf
*.docx
*.csv
# Exceptions for test fixtures or sample documents if placed in tests/
!backend/tests/**

# ------------------------------------------------------------------------------
# 4. Node.js & Next.js Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.next/
*/.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Python Runtimes & Caches
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
