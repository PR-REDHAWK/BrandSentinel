# BrandSentinel Backend Environment Variables
APP_NAME=BrandSentinel
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & JWT (Generate a secure random string for production)
SECRET_KEY=your_super_secret_jwt_key_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# SQLite: sqlite:///./brandsentinel.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/brandsentinel
DATABASE_URL=sqlite:///./brandsentinel.db

# Storage Directories (Files are stored here locally)
UPLOAD_DIR=./uploads

# AI Providers (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.0-flash
